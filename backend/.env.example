# Server Port
PORT=8080

# Database Connection
# Option A: Full JDBC URL (Recommended for cloud providers like Aiven / TiDB)
# DB_URL=jdbc:mysql://your-db-host.aivencloud.com:port/defaultdb?sslMode=REQUIRED&serverTimezone=UTC

# Option B: Separate host & credentials (for local development)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blooddonation
DB_USERNAME=root
DB_PASSWORD=your_local_password_here

# Hibernate / JPA
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# Central CORS allowed origins (comma-separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-frontend.vercel.app

# Optional demo seeder (true / false)
SEED_DEMO_DATA=false
