# Server Port
PORT=8080

# Database Connection (Option A - full URL)
# SPRING_DATASOURCE_URL=jdbc:mysql://your-cloud-mysql-host:3306/blooddonation?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true

